# Copy to .env (ignored by git) and adjust.
# Used by deploy.sh:
DEPLOY_HOST=root@192.168.1.10
#DEPLOY_KEY=~/.ssh/id_ed25519
#DEPLOY_DIR=fotos-web
# Used by docker-compose.yml / server.mjs:
# Default works only if Immich and this app share a Docker host/network.
# For a different machine use docker-compose.standalone.yml and set the real address:
#IMMICH_URL=http://immich_server:2283
#PUBLIC_PORT=8090
# Name of Immich's Docker network (same-host setup only):
#IMMICH_NETWORK=immich_default
